{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "rogers-holdings-business-snapshot-staging",
  "main": "src/worker.js",
  "compatibility_date": "2026-07-29",
  "workers_dev": true,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "env": {
    "staging": {
      "name": "rogers-holdings-business-snapshot-staging",
      "vars": {
        "BUSINESS_SNAPSHOT_ENVIRONMENT": "NON_PRODUCTION",
        "BUSINESS_SNAPSHOT_ALLOWED_ORIGIN": "SELF",
        "BUSINESS_SNAPSHOT_TURNSTILE_ACTION": "",
        "BUSINESS_SNAPSHOT_TURNSTILE_HOSTNAME": "",
        "TURNSTILE_SITE_KEY": "1x00000000000000000000AA"
      },
      "ratelimits": [
        {
          "name": "BUSINESS_SNAPSHOT_RATE_LIMITER",
          "namespace_id": "20260729",
          "simple": {
            "limit": 20,
            "period": 60
          }
        },
        {
          "name": "BUSINESS_SNAPSHOT_REQUEST_LIMITER",
          "namespace_id": "20260730",
          "simple": {
            "limit": 5,
            "period": 60
          }
        }
      ]
    }
  }
}
