{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "rogers-holdings-business-snapshot-production",
  "main": "src/worker.js",
  "compatibility_date": "2026-07-29",
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "vars": {
    "BUSINESS_SNAPSHOT_ENVIRONMENT": "production",
    "BUSINESS_SNAPSHOT_TURNSTILE_ACTION": "business_snapshot",
    "BUSINESS_SNAPSHOT_TURNSTILE_HOSTNAME": "rogersholdingsllc.com"
  },
  "ratelimits": [
    {
      "name": "BUSINESS_SNAPSHOT_RATE_LIMITER",
      "namespace_id": "2001",
      "simple": {
        "limit": 20,
        "period": 60
      }
    },
    {
      "name": "BUSINESS_SNAPSHOT_REQUEST_LIMITER",
      "namespace_id": "2002",
      "simple": {
        "limit": 5,
        "period": 60
      }
    }
  ]
}
